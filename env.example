# =============================================================================
# beCPG Supplier Portal — environment
#
# Copy to `.env.local` for development, inject as container env in production.
#
# IMPORTANT: no NEXT_PUBLIC_* variable holds a secret here, and there is no
# NEXT_PUBLIC_ OIDC configuration at all. Authentication is server-side only:
# the OIDC token and the Alfresco ticket never reach the browser (spec §5.3, §6).
# =============================================================================

# -----------------------------------------------------------------------------
# OIDC / Keycloak (IDS) — one realm per tenant
# -----------------------------------------------------------------------------

# Keycloak base URL, WITHOUT the realm (the realm is resolved per tenant).
# dev: https://ids-test.becpg.fr/auth   prod: https://ids.becpg.fr/auth
OIDC_ISSUER_BASE=https://ids-test.becpg.fr/auth

# Confidential client used by the portal's route handlers (code flow + PKCE).
OIDC_CLIENT_ID=dev-openid
OIDC_CLIENT_SECRET=change-me

# Public base URL of the portal, used to build the redirect_uri
# (<PORTAL_BASE_URL>/api/auth/callback). Must match the Keycloak client config.
PORTAL_BASE_URL=http://localhost:3000

# Scopes requested. The JWT MUST carry the `becpg_url` and `becpg_instance`
# claims; a token without them is rejected with 401.
OIDC_SCOPES=openid profile email

# Clock tolerance (seconds) when validating the ID token.
OIDC_CLOCK_TOLERANCE=30

# Catalogues that FORBID finishing a sheet, comma separated by their beCPG id
# (`incoRawMaterials,allergens`). `all` gates on every catalogue beCPG returns —
# the "100 % or nothing" setting.
#
# Unset by default, and that default is deliberate: beCPG publishes a catalogue's
# score and its missing fields but NO marker saying whether it blocks, so the
# portal cannot deduce the answer. Treating "undeclared" as "blocking" made every
# wizard unfinishable on any instance whose catalogue sits below 100 % — a rule
# the repository never expressed, applied in its name. Unset, the supplier still
# sees the score and the missing fields in the Conformité step, and beCPG remains
# the authority on whether a task may be completed.
# PORTAL_BLOCKING_CATALOGS=

# Whether the sign-out may ask the identity provider to send the browser back to
# /login (`post_logout_redirect_uri`).
#
#   auto  (default) ask the end_session endpoint once per issuer and remember the
#         answer. A 400 means the URI is not registered on the client, and the
#         parameter is then dropped so the user still signs out — on the IdP's own
#         page instead of the portal's;
#   on    always send it (skip the probe);
#   off   never send it.
#
# The real repair is on the identity provider: the client's "Valid post logout
# redirect URIs" must list <PORTAL_BASE_URL>/login. Measured on ids-test.becpg.fr /
# dev-supplier-portal: https://portal.becpg.fr/login is registered (302), while
# http://localhost:3000/login and .../api/auth/callback are refused (400) — so "+"
# is NOT enough, the entry is exact, and a local run signs out on Keycloak's page.
# OIDC_POST_LOGOUT_REDIRECT=auto

# -----------------------------------------------------------------------------
# Session cookie (JWE, httpOnly)
# -----------------------------------------------------------------------------

# 32-byte secret used to encrypt the session cookie holding the OIDC token and
# the Alfresco ticket. Generate with: openssl rand -base64 32
SESSION_COOKIE_SECRET=change-me-32-bytes-base64-value==

# Cookie name and lifetime (seconds). Encrypted payload, never readable client-side.
SESSION_COOKIE_NAME=becpg_portal_session
SESSION_TTL=28800

# Set to false only for plain-HTTP local development.
SESSION_COOKIE_SECURE=true

# -----------------------------------------------------------------------------
# Multitenant (spec §5.3)
# -----------------------------------------------------------------------------

# Tenant used when the request carries no subdomain and no /t/<tenant> segment.
DEFAULT_TENANT=dev

# Tenant map, JSON. One entry per tenant:
#   realm      Keycloak realm for this tenant
#   label      display name in the header
#   logo       path served from /public (or absolute URL)
#   becpgUrl   optional fallback when the JWT claim is absent (integrations)
#   isTest     forces the TEST banner regardless of PORTAL_TEST_MODE
TENANT_MAP={"dev":{"realm":"dev","label":"beCPG Dev","logo":"/theme/default/images/logo.png","becpgUrl":"https://dev.becpg.fr","isTest":true},"demo":{"realm":"demo","label":"beCPG Demo","logo":"/theme/default/images/logo.png","becpgUrl":"https://demo.becpg.fr","isTest":true}}

# Hostname suffix used to derive the tenant from the subdomain
# (https://<tenant>.portail.becpg.fr).
TENANT_HOST_SUFFIX=.portail.becpg.fr

# -----------------------------------------------------------------------------
# beCPG back end
# -----------------------------------------------------------------------------

# Fallback beCPG base URL when the JWT provides no `becpg_url` claim.
# In normal operation the claim wins; this is for internal integrations only.
BECPG_URL=https://dev.becpg.fr

# Timeout (ms) applied to every proxied Alfresco call.
BECPG_TIMEOUT=30000

# -----------------------------------------------------------------------------
# becpg-ai (document extraction, field suggestions)
# -----------------------------------------------------------------------------
#
# NOTHING TO CONFIGURE HERE, and that is the point.
#
# The portal does not call becpg-ai. It asks the repository — `becpg/ai/suggestions`,
# `…/apply`, `…/apply-plan` — exactly as it asks `becpg/olap/chart` for the cube. The
# becpg-ai address and the caller credential live in beCPG (`beCPG.ai.serverUrl`,
# `BeCPGTicketService`), which is the only place that owns the auth-token format.
#
# The four variables that used to live here — BECPG_AI_URL, BECPG_AI_API_KEY,
# BECPG_AI_INSTANCE_NAME, BECPG_AI_TENANT — are gone. Setting them now does nothing.
#
# To turn the AI panels off: leave `beCPG.ai.serverUrl` empty on the instance. The proxy
# answers 503 `aiNotConfigured` and the wizard hides the suggestion step.
# An instance whose becpg-core predates `AiSuggestionsProxyWebScript` answers 404, which
# the portal treats the same way.

# -----------------------------------------------------------------------------
# Portal behaviour
# -----------------------------------------------------------------------------

# Forces the permanent, non-dismissable TEST banner on every page.
# Any non-production instance must run with this set to true (spec §4.3).
PORTAL_TEST_MODE=true

# Default chrome language when the user has no preference cookie: fr | en
PORTAL_DEFAULT_LANG=fr

# Notice window (days) before a document expiry is shown as "expiring".
PORTAL_EXPIRY_NOTICE_DAYS=60

# Server-side cache TTL (seconds) for the derived approval status (spec §5.4.3).
PORTAL_APPROVAL_CACHE_TTL=60

# Verbose server logs for the proxy layer.
PORTAL_DEBUG=false

# Extra Alfresco groups that open /monitor, ADDED to the built-in list
# (lib/adapters/session.js, MONITOR_GROUPS). Comma-separated, names with or without the
# `GROUP_` prefix. For a customer who organises its internal roles differently.
# An ExternalUser is refused first and unconditionally, whatever this contains.
# PORTAL_MONITOR_GROUPS=GROUP_QUALITE,GROUP_ACHATS

# Timeout (ms) of a formulation call — POST /api/v1/wizard/{entityId}/formulate.
# Deliberately far above BECPG_TIMEOUT: a full formulation is a long synchronous
# repository operation, not a REST read.
BECPG_FORMULATE_TIMEOUT=120000

# Project templates `POST /api/v1/process/start` may instantiate.
#
# LEAVE THIS UNSET IN NORMAL DEPLOYMENTS. The portal discovers the supplier
# referencing templates at runtime (lib/adapters/processTemplates.js), using the
# marker beCPG itself sets on them: type `pjt:project` + aspect `bcpg:entityTplAspect`
# + aspect `bcpg:suppliersAspect`, `bcpg:entityTplEnabled` not false — the very
# datasource Share's "envoyer au fournisseur" dialog uses. No nodeRef to paste, and
# nothing to redo after a template is re-imported.
#
# This variable is the **override**, for the two cases discovery cannot serve:
#   - an installation that already pinned a nodeRef and must keep behaving as before;
#   - an operator who wants to restrict the portal to a subset of what exists.
# When it is set it wins outright and **no discovery query is issued at all**.
#
# Comma-separated. Each entry is a nodeRef, or `id=nodeRef` to give the template a
# stable id the UI can send instead of a nodeRef. **A set-but-unusable value means no
# process may be started at all** — deny-by-default is deliberate, and it survives
# discovery: an instance with no marked template resolves to an empty list, and a
# request naming any other template is refused whatever the source of the list.
# PORTAL_PROCESS_TEMPLATES=supplier-referencing=workspace://SpacesStore/1234-…,supplier-renewal=workspace://SpacesStore/5678-…

# How long a discovered template list is trusted, in seconds (0 disables caching).
# Cached per tenant *and* per user, because the discovery query is permission
# filtered. Ignored when PORTAL_PROCESS_TEMPLATES is set.
PORTAL_PROCESS_TEMPLATES_TTL=300

# -----------------------------------------------------------------------------
# Authentication — aliases and additional variables (lib/tenant.js, lib/session.js,
# lib/oidc.js). Added by the auth layer; the names above keep working.
# -----------------------------------------------------------------------------

# Tenant map — canonical name read by lib/tenant.js. `TENANT_MAP` above is
# accepted as an alias; set only one of the two. Same JSON shape.
# BECPG_TENANTS={"demo":{"realm":"demo","label":"beCPG Demo","logo":"/theme/default/images/logo.png","becpgUrl":"https://demo.becpg.fr","isTest":true}}

# Session encryption key — canonical name read by lib/session.js.
# `SESSION_COOKIE_SECRET` above is accepted as an alias. Any format works, the
# 256-bit key is derived with SHA-256. Generate with: openssl rand -base64 32
# SESSION_SECRET=change-me

# Instance id used by the single-tenant fallback, when no tenant map is set at
# all: the portal then serves one tenant built from BECPG_URL + BECPG_INSTANCE.
BECPG_INSTANCE=dev

# Full issuer URL, overriding <OIDC_ISSUER_BASE>/realms/<realm>. Only useful for
# a single-realm deployment or a non-Keycloak provider.
# OIDC_ISSUER=https://ids-test.becpg.fr/auth/realms/dev
# OIDC_REALM=dev

# -----------------------------------------------------------------------------
# Alternative ticket mode (internal integrations) — becpg-ai/doc/authentication_fr.md
#
# When BECPG_TICKET is set and BECPG_TICKET_MODE is true, the portal skips the
# OIDC → ticket exchange entirely and uses this ticket, sent to beCPG as
# `BECPG_TICKET` + `X-BecPG-Instance` headers. Never enable this in production.
# -----------------------------------------------------------------------------

# BECPG_TICKET=TICKET_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# BECPG_TICKET_MODE=false

# Assumed lifetime (seconds) of an Alfresco ticket. The portal re-exchanges the
# OIDC token for a fresh ticket shortly before this horizon.
BECPG_TICKET_TTL=3600

# -----------------------------------------------------------------------------
# DEV_FAKE_AUTH — development escape hatch (spec §5.3 is unchanged in production)
#
# Makes the portal runnable against dev.becpg.fr WITHOUT a configured OIDC
# client: GET /api/auth/login skips the Keycloak round trip, logs into Alfresco
# directly with the credentials below
# (POST /alfresco/api/-default-/public/authentication/versions/1/tickets), and
# writes the very same encrypted session cookie — same shape, same proxy path,
# only `authMode: "dev"` differs.
#
# The handler REFUSES to run when NODE_ENV=production, whatever the flag says.
# The ticket is renewed by re-login when it expires.
# -----------------------------------------------------------------------------

DEV_FAKE_AUTH=false
BECPG_DEV_USER=
BECPG_DEV_PASSWORD=

# Several dev accounts instead of one, so `/api/auth/login?devUser=<label>` can switch
# perspective (internal vs supplier) without editing the file. Comma-separated
# `label=login:password`. The label is all the browser ever sends; the credentials stay
# server-side. Ignored unless DEV_FAKE_AUTH=true, and refused under NODE_ENV=production
# like the rest of this block.
# BECPG_DEV_ACCOUNTS=admin=admin:becpg,fournisseur=supplier.local@becpg.fr:secret

# -----------------------------------------------------------------------------
# Share — the wizard configuration source (lib/becpg.js, lib/adapters/wizardConfig.js,
# doc/becpg-api-contracts.md §8)
#
# The portal reads *which fields a step shows* from Share, because Share is what
# resolves the beCPG form cascade (formId + entityType + siteId + list) and
# therefore what carries the client overrides (Bridor, Aryzta). Alfresco cannot
# answer that question.
# -----------------------------------------------------------------------------

# Base URL of Share, when it is NOT on the same host as BECPG_URL. On a standard
# deployment (dev.becpg.fr serves /alfresco and /share) leave this unset and the
# base is derived from BECPG_URL.
#
# Set it for the local instance, where Alfresco is on :8080 and Share on :8180.
# Careful: Next.js loads `.env` IN ADDITION to the custom loaded environment, so a `.env`
# pointing at the local Share leaks into a run aimed at dev — the portal then
# takes its data from dev and its configuration from localhost, resolves a
# wizard whose nodeRefs it has never seen, and renders ten steps with zero
# fields, silently. Always set it explicitly per run.
# BECPG_SHARE_URL=http://localhost:8180

# Path of the wizard webscript, relative to the Share base.
#
# SET   → primary mode: one call returns the wizard, its steps AND the resolved
#         form definitions. Requires the four `.../becpg/portal/` files to be
#         deployed on that Share (they live on the beCPG working branch only).
# UNSET → fallback mode: config/wizards.default.js + the existing
#         entity-datagrid columns endpoint. Use this against an instance where
#         the webscript is not deployed, e.g. dev.becpg.fr today.
# BECPG_SHARE_WIZARD_ENDPOINT=service/becpg/portal/wizard

# -----------------------------------------------------------------------------
# Wizard / column configuration cache
# -----------------------------------------------------------------------------

# How long a resolved wizard structure or column set is reused, in seconds.
# Default 300. `0` disables the cache entirely — correct, and expensive: measured
# on the local 26.1 instance, one `GET /api/v1/wizard/{id}` costs 1435 ms cold
# against 50 ms warm, because a ten-step wizard means a Share resolution per step.
# WIZARD_CACHE_TTL=300
# La configuration (structures de wizard, colonnes) est mise en cache par tenant et par
# utilisateur pendant WIZARD_CACHE_TTL. Rafraîchir un wizard dans Share peut donc rester
# invisible jusqu'à cette durée : POST /api/v1/config/refresh vide le cache immédiatement
# ({"scope":"tenant"} pour tout le tenant, réservé aux profils de pilotage).

# -----------------------------------------------------------------------------
# Build metadata
# -----------------------------------------------------------------------------

# Stamped at build time by the Dockerfile (`--build-arg PORTAL_VERSION=…`) and by
# Cloud Build; served by GET /api/health as `version`. Falls back to the
# package.json version, then to "dev". Not something to set by hand locally.
# PORTAL_VERSION=0.0.1

# Types de documents reconnus comme « fiche technique fournisseur » — l'unique document
# demandé en étape 1 de l'assistant (spec §4.4) et le seul support des suggestions
# d'extraction. Libellés ou codes séparés par des virgules ; le rapprochement est fait
# sur une forme normalisée (minuscules, sans accent) et par inclusion, donc
# « Fiche technique fournisseur » correspond à « fiche technique ».
# Renseignée, cette variable REMPLACE les valeurs par défaut
# (fiche technique, technical sheet, technical data sheet, product data sheet).
# PORTAL_TECHNICAL_SHEET_TYPES=Fiche technique fournisseur,FT-FOURN
